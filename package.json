{
  "name": "volt-preline",
  "version": "0.1.0",
  "description": "Preline UI (free tier, MIT) components for Remix 3 UI \u2014 same component API as volt-catalyst, interactions via remix/ui primitives (no preline.js).",
  "license": "MIT",
  "author": "Laravolt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laravolt/volt-preline.git"
  },
  "homepage": "https://github.com/laravolt/volt-preline#readme",
  "bugs": {
    "url": "https://github.com/laravolt/volt-preline/issues"
  },
  "keywords": [
    "remix",
    "remix-3",
    "remix-ui",
    "preline",
    "tailwindcss",
    "components",
    "ui-kit",
    "volt",
    "laravolt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CONVENTIONS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i ./playground/styles.css -o ./playground/public/app.css",
    "playground": "npm run -s css && NODE_ENV=development node --import remix/node-tsx playground/server.tsx",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "preline": "5.0.0"
  },
  "peerDependencies": {
    "remix": "3.0.0-rc.1",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/forms": "^0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/forms": "0.5.10",
    "@types/node": "25.5.0",
    "remix": "3.0.0-rc.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  }
}
